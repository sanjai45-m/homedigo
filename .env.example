# ==========================================
# 🏥 HomeDigo Platform - Environment Config
# ==========================================

# 1. Database Connection (Neon Serverless PostgreSQL)
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. NextAuth Secret & App URL
NEXTAUTH_URL="http://localhost:3000"
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=""
# Optional: used only when no super-admin exists. Use a unique strong password, then remove this variable.
BOOTSTRAP_SUPER_ADMIN_PASSWORD=""

# 3. Google OAuth 2.0 Credentials (Configurable)
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# 4. App Mode
NEXT_PUBLIC_APP_NAME="HomeDigo"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional trusted origin for admin password reset emails (use your HTTPS domain in production).
PASSWORD_RESET_BASE_URL=""

# 5. Initial UPI configuration (super-admin settings take precedence).
# This demo ID cannot receive payments. Replace it with the real linked UPI ID.
UPI_PAYEE_ID="homedigo-demo@example"
UPI_PAYEE_NAME="HomeDigo"

# 6. Appointment email delivery (doctor review and patient confirmation)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="HomeDigo Health"
SMTP_FROM_EMAIL=""
# Protect the existing /api/cron/appointment-reminders retry worker.
CRON_SECRET=""

# 7. Firebase web push (optional; enable only after all fields are configured).
# Public web app config: Firebase Project settings > General > Your apps > Web.
WEB_PUSH_ENABLED="false"
FIREBASE_PROJECT_ID=""
FIREBASE_WEB_API_KEY=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_WEB_APP_ID=""
# Cloud Messaging > Web configuration > Web Push certificates > public key.
FIREBASE_WEB_VAPID_KEY=""
# Server only: Service accounts > Firebase Admin SDK. NEVER use NEXT_PUBLIC_ for these.
FIREBASE_CLIENT_EMAIL=""
# Paste the private_key value with literal \n escapes between lines.
FIREBASE_PRIVATE_KEY=""
